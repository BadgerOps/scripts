#!/usr/bin/env bash
#
# checkport — lightweight TCP-port–open check
#
# Usage:
#   checkport [ -h|--help ] HOST PORT
#
# Exit codes:
#   0  Port is open on HOST:PORT
#   1  Port is not open after retries
#   2  Usage error (bad args or --help)
#
# Requirements:
#   - Bash with /dev/tcp support
#   - GNU timeout
#
# This script attempts to open a TCP connection to HOST:PORT up to 5 times,
# sleeping 5 seconds between attempts.  On the first successful connect, it
# exits with 0 immediately.  If all retries fail, it exits with 1.

# Default retry parameters
RETRIES=5
SLEEP_INTERVAL=2
TIMEOUT_SEC=2

usage() {
  cat <<EOF
Usage: $0 [ -h|--help ] HOST PORT

Options:
  -h, --help    Show this help message and exit

Exit codes:
  0  Port is open on HOST:PORT
  1  Port is not open after retries
  2  Usage error (bad args or --help)
EOF
}

# Show help
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 2
fi

# Verify arguments
if [[ $# -lt 2 ]]; then
  usage
  exit 2
fi

HOST=$1
PORT=$2

count=0
while ((count < RETRIES)); do
  timeout "$TIMEOUT_SEC" bash -c "exec 3>/dev/tcp/${HOST}/${PORT}" >/dev/null 2>&1
  if [[ $? -eq 0 ]]; then
    exit 0
  fi
  ((count++))
  sleep "$SLEEP_INTERVAL"
done

exit 1
